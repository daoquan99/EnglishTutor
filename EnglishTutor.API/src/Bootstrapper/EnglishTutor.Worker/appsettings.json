{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=english_tutor_db;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Database": {
    "AutoMigrate": false
  },
  "Outbox": {
    "ProcessingIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5,
    "LockDurationSeconds": 60
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "storage",
    "BaseUrl": "/storage"
  },
  "AiProviders": {
    "Google": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "ApiKeySecretName": "AI_PROVIDERS:GOOGLE:API_KEY",
      "DefaultModelCode": "gemini-2.5-flash",
      "ModelAliases": {
        "gemini-flash": "gemini-2.5-flash",
        "gemini-pro": "gemini-2.5-pro"
      }
    },
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1",
      "ApiKeySecretName": "AI_PROVIDERS:OPENAI:API_KEY",
      "DefaultModelCode": "gpt-4o-mini"
    },
    "DeepSeek": {
      "BaseUrl": "https://api.deepseek.com",
      "ApiKeySecretName": "AI_PROVIDERS:DEEPSEEK:API_KEY",
      "DefaultModelCode": "deepseek-v4-flash",
      "ModelAliases": {
        "deepseek-chat": "deepseek-v4-flash",
        "deepseek-reasoner": "deepseek-v4-pro"
      }
    }
  }
}
