{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Quartz": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Auth": {
    "Cookies": {
      "Secure": true,
      "SameSite": "None",
      "Path": "/api/auth"
    }
  },
  "SeedData": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrate": true
  }
}
