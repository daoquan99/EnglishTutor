{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "",
    "Audit": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "ApplySeedDataOnStartup": true,
    "Modules": {
      "Identity": {
        "ApplyMigrationsOnStartup": false
      },
      "Audit": {
        "ApplyMigrationsOnStartup": false
      },
      "Learning": {
        "ApplyMigrationsOnStartup": false
      },
      "AiGateway": {
        "ApplyMigrationsOnStartup": false
      },
      "Quota": {
        "ApplyMigrationsOnStartup": false
      },
      "Practice": {
        "ApplyMigrationsOnStartup": false
      },
      "Feedback": {
        "ApplyMigrationsOnStartup": false
      }
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "AiGateway": {
    "DefaultLeaseTtlMinutes": 10,
    "EncryptionMasterKey": ""
  },
  "Jwt": {
    "ClockSkewSeconds": 30
  },
  "Identity": {
    "Security": {
      "MaxFailedLoginAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "Auth": {
    "RateLimit": {
      "Enabled": true,
      "Login": {
        "PermitLimit": 10,
        "WindowSeconds": 300
      },
      "Refresh": {
        "PermitLimit": 30,
        "WindowSeconds": 300
      },
      "Logout": {
        "PermitLimit": 30,
        "WindowSeconds": 300
      },
      "SessionMutation": {
        "PermitLimit": 30,
        "WindowSeconds": 300
      }
    }
  }
}
