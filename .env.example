# PostgreSQL
POSTGRES_DB=english_tutor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Override default host ports when 5432/5672/6379 are unavailable on this machine.
# Uncomment any line and change the value; docker compose reads these via .env.
# POSTGRES_HOST_PORT=5432
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_MGMT_HOST_PORT=15672
# REDIS_HOST_PORT=6379

# Redis
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379

# Redis Insight
REDIS_INSIGHT_PORT=5540

# JWT
# Use a local-only value for development and a secret manager in production.
Jwt__Secret=k8Fz2mR9vPqL4xYwN3jH7aBcDe5gT1uKoS6nWi0rXhQpVlEtMd8sJfUyC2bZnOm

# AI provider API keys
# Use dotnet user-secrets locally. In Docker/production, set real values through env/secret manager.
# AI_PROVIDERS__GOOGLE__API_KEY=
# AI_PROVIDERS__OPENAI__API_KEY=
# AI_PROVIDERS__DEEPSEEK__API_KEY=

# File storage
Storage__Provider=Local
Storage__LocalPath=storage
Storage__BaseUrl=/storage
# For S3/R2, set Storage__Provider=S3 or CloudflareR2 and provide:
# Storage__BucketName=
# Storage__Region=
# Storage__AccessKey=
# Storage__SecretKey=
# Storage__ServiceUrl=

# Seed data
SeedData__Enabled=true
SeedData__Admin__Email=admin@englishtutor.local
SeedData__Admin__Password=Admin123@!
SeedData__Admin__DisplayName=System Admin

# Local development
Database__AutoMigrate=false
# Run everything with Aspire:
# dotnet run --project src/Bootstrapper/EnglishTutor.AppHost/EnglishTutor.AppHost.csproj
# Or run dependencies only:
# docker compose up -d
